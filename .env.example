# Docker 部署配置（复制为 .env）。镜像由 docker compose 从本仓库源码构建。
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# 容器运行用的 UID（install.sh 会自动写成你的 `id -u`），让 ./data 与 ./skills 在容器内可写。
ARTEX_UID=10001
# 写进二进制的版本号（仅用于界面显示）。
ARTEX_VERSION=dev

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=
